.section-head {

  max-width: 850px;

  margin: 0 auto 55px;

  text-align: center;

}

.section-head h2 {

  margin: 18px 0;

  color: #102c43;

  font-size: clamp(2.3rem, 4.5vw, 3.7rem);

  line-height: 1.08;

  letter-spacing: -.035em;

}

.section-head p {

  color: #65717d;

  line-height: 1.8;

  font-size: 1.05rem;

}

.report-sections {

  max-width: 1050px;

  margin: auto;

  border-top: 1px solid #d9e1e8;

}

.report-sections article {

  display: grid;

  grid-template-columns: 90px 1fr;

  gap: 24px;

  padding: 28px 0;

  border-bottom: 1px solid #d9e1e8;

}

.report-sections article > span {

  font-size: 1.1rem;

  font-weight: 900;

  color: #0e5c8d;

}

.report-sections h3 {

  margin: 0 0 7px;

  color: #102c43;

  font-size: 1.35rem;

}

.report-sections p {

  margin: 0;

  color: #65717d;

  line-height: 1.7;

}


/* ==========================================================
   SAMPLE REPORT
========================================================== */

.download-panel {

  display: flex;

  justify-content: space-between;

  align-items: center;

  gap: 30px;

  margin: 55px auto 0;

  max-width: 1050px;

  padding: 30px;

  background: #eef3f7;

  border: 1px solid #d5dde5;

}

.download-panel h3 {

  margin: 8px 0;

  color: #102c43;

  font-size: 1.5rem;

}

.download-panel p {

  margin: 0;

  color: #66737f;

}

.download-panel a,
.pi-cta a,
.result-next a {

  color: #0e5c8d;

  font-weight: 800;

  text-decoration: none;

  white-space: nowrap;

}


/* ==========================================================
   PROPERTY DETAILS
========================================================== */

.property-detail-panel,
.project-requirements-panel {

  margin-top: 18px;

  padding: 28px;

  background: #ffffff;

  border: 1px solid #d7dfe7;

}

.detail-panel-head {

  margin-bottom: 20px;

}

.detail-panel-head h3 {

  margin: 7px 0;

  color: #102c43;

  font-size: 1.35rem;

}

.detail-panel-head p {

  margin: 0;

  color: #65717d;

  line-height: 1.65;

  max-width: 800px;

}

.property-detail-grid {

  display: grid;

  grid-template-columns: repeat(4, 1fr);

  gap: 10px;

}

/* ==========================================================
   PROPERTY MAP
========================================================== */

:global(.property-map-section) {
  margin-top: 20px;
}

:global(.property-map-runtime) {
  width: 100%;
  height: 500px;
  min-height: 500px;
  border: 1px solid #d7dfe7;
  border-radius: 4px;
  overflow: hidden;
  background: #eef3f7;
}

:global(.property-map-runtime.leaflet-container) {
  width: 100%;
  height: 500px;
  min-height: 500px;
}


:global(.property-detail-item) {

  display: flex;

  flex-direction: column;

  gap: 7px;

  padding: 14px;

  background: #f5f7fa;

  border: 1px solid #dbe2e8;

}

:global(.property-detail-item span),
:global(.requirement-item span) {

  display: block;

  color: #74818d;

  font-size: .64rem;

  font-weight: 800;

  letter-spacing: .09em;

  line-height: 1.3;

  text-transform: uppercase;

}

:global(.property-detail-item strong) {

  display: block;

  margin: 0;

  color: #102c43;

  font-size: .92rem;

  line-height: 1.4;

  overflow-wrap: anywhere;

}

:global(.project-requirements-list) {

  display: grid;

  gap: 10px;

}

:global(.requirement-item) {

  display: flex;

  flex-direction: column;

  gap: 7px;

  padding: 16px;

  background: #f5f7fa;

  border: 1px solid #dbe2e8;

}

:global(.requirement-item strong) {

  display: block;

  margin: 0;

  color: #102c43;

  font-size: .94rem;

  line-height: 1.55;

  overflow-wrap: anywhere;

}

:global(.requirement-item small) {

  display: block;

  margin-top: 2px;

  color: #7b8792;

  line-height: 1.45;

  overflow-wrap: anywhere;

}

:global(.requirement-item a) {

  color: #0e5c8d;

  font-size: .78rem;

  font-weight: 800;

  text-decoration: none;

}

:global(.requirement-item a:hover) {

  text-decoration: underline;

}

.requirement-item a:hover {

  text-decoration: underline;

}


/* ==========================================================
   RESULT
========================================================== */

.pi-result {

  padding: 0 0 110px;

  background: #ffffff;

}

.result-shell {

  background: #f5f7fa;

  border: 1px solid #d5dde5;

  padding: 44px;

}

.result-header {

  display: flex;

  justify-content: space-between;

  gap: 30px;

  align-items: flex-start;

  border-bottom: 1px solid #d5dde5;

  padding-bottom: 28px;

}

.result-header h2 {

  margin: 14px 0 8px;

  color: #102c43;

  font-size: 2.5rem;

}

.result-header p {

  margin: 0;

  color: #5f6c78;

  line-height: 1.7;

}

.result-goal {

  margin-top: 8px !important;

  color: #0e5c8d !important;

  font-size: .9rem;

  font-weight: 700;

}

.mode-badge {

  padding: 9px 12px;

  background: #fff3d8;

  color: #8a641d;

  border: 1px solid #ead6a3;

  font-size: .68rem;

  font-weight: 900;

  letter-spacing: .1em;

}

.result-grid {

  display: grid;

  grid-template-columns: repeat(4, 1fr);

  gap: 14px;

  padding: 30px 0;

}

:global(.result-card) {

  background: #ffffff;

  border: 1px solid #d7dfe7;

  padding: 20px;

}

:global(.result-card span) {

  display: block;

  color: #74818d;

  font-size: .66rem;

  font-weight: 800;

  letter-spacing: .11em;

  line-height: 1.3;

}

:global(.result-card strong) {

  display: block;

  margin: 8px 0;

  color: #102c43;

  font-size: 1.25rem;

  line-height: 1.2;

}

:global(.result-card p) {

  margin: 0;

  color: #65717d;

  line-height: 1.6;

  font-size: .93rem;

}

.result-next {

  display: flex;

  justify-content: space-between;

  gap: 25px;

  align-items: center;

  padding: 24px;

  background: #ffffff;

  border: 1px solid #d7dfe7;

}

.result-next strong {

  color: #102c43;

}

.result-next p {

  margin: 6px 0 0;

  color: #65717d;

}


/* ==========================================================
   ENGINEERING CTA
========================================================== */

.pi-cta {

  padding: 70px 0;

  background: #0b2337;

  color: #ffffff;

}

.pi-cta .container {

  display: flex;

  justify-content: space-between;

  gap: 40px;

  align-items: center;

}

.pi-cta h2 {

  max-width: 800px;

  margin: 16px 0 0;

  color: #ffffff;

  font-size: clamp(2rem, 4vw, 3.3rem);

  line-height: 1.08;

}

.pi-cta a {

  padding: 17px 24px;

  background: #ffffff;

  color: #0b2337;

  border-radius: 999px;

}


/* ==========================================================
   RESPONSIVE
========================================================== */

@media (max-width: 1050px) {

  .pi-hero-grid {

    grid-template-columns: 1fr;

    gap: 50px;

  }

  .hero-report {

    max-width: 760px;

  }

  .result-grid {

    grid-template-columns: 1fr 1fr;

  }

  .property-detail-grid {

    grid-template-columns: 1fr 1fr;

  }

  .pi-cta .container {

    flex-direction: column;

    align-items: flex-start;

  }

}

@media (max-width: 760px) {

  .goal-grid {

    grid-template-columns: 1fr 1fr;

  }

}

@media (max-width: 650px) {

  .pi-hero {

    padding: 70px 0;

  }

  .pi-hero h1 {

    font-size: 2.7rem;

  }

  .search-row {

    grid-template-columns: 1fr;

  }

  .goal-grid {

    grid-template-columns: 1fr;

  }

  .hero-report {

    grid-template-columns: 1fr;

  }

  .hero-report-rail {

    min-height: 220px;

  }

  .hero-report-rail span {

    margin-top: 65px;

  }

  .result-shell {

    padding: 24px;

  }

  .result-header,
  .result-next,
  .download-panel {

    flex-direction: column;

    align-items: flex-start;

  }

  .result-grid {

    grid-template-columns: 1fr;

  }

  .property-detail-grid {

    grid-template-columns: 1fr;

  }

  .property-detail-panel,
  .project-requirements-panel {

    padding: 20px;

  }

}

