</Layout>


<script>
  const form = document.querySelector("#property-form");
  import L from "leaflet";
  import "leaflet/dist/leaflet.css";
  const status = document.querySelector("#form-status");

  const result = document.querySelector("#result-section");
  const resultAddress = document.querySelector("#result-address");
  const resultMessage = document.querySelector("#result-message");
  const resultGoal = document.querySelector("#result-goal");
  const resultMode = document.querySelector("#result-mode");
  const resultCards = document.querySelector("#result-cards");
  const propertyDetailPanel = document.querySelector("#property-detail-panel");
  const propertyDetailGrid = document.querySelector("#property-detail-grid");
  const propertyMapSection =
  document.querySelector("#property-map-section");

const propertyMapMount =
  document.querySelector("#property-map-mount");
  let propertyMapInstance = null;
  const projectRequirementsPanel = document.querySelector(
    "#project-requirements-panel"
  );
  const projectRequirementsList = document.querySelector(
    "#project-requirements-list"
  );
  const resultNext = document.querySelector("#result-next-text");

  const approvalPathwayPanel = document.querySelector(
    "#approval-pathway-panel"
  );

  const approvalPathwaySummary = document.querySelector(
    "#approval-pathway-summary"
  );

  const approvalPathwayDetails = document.querySelector(
    "#approval-pathway-details"
  );

  const submitButton = document.querySelector("#submit-button");

  const addressInput = document.querySelector("#address");
  const addressSuggestions =
    document.querySelector("#address-suggestions");

  const API_BASE =
    "http://127.0.0.1:8000";

  let suggestionTimer = null;
  let suggestionAbortController = null;
  let suggestionItems = [];
  let activeSuggestionIndex = -1;

  function closeAddressSuggestions() {
    if (!addressSuggestions || !addressInput) {
      return;
    }

    addressSuggestions.hidden = true;
    addressSuggestions.innerHTML = "";
    addressInput.setAttribute(
      "aria-expanded",
      "false"
    );

    suggestionItems = [];
    activeSuggestionIndex = -1;
  }

  function selectAddressSuggestion(index) {
    const item = suggestionItems[index];

    if (!item || !addressInput) {
      return;
    }

    addressInput.value = item.address || "";
    closeAddressSuggestions();
    addressInput.focus();
  }

  function renderAddressSuggestions(items) {
    if (!addressSuggestions || !addressInput) {
      return;
    }

    suggestionItems = items || [];
    activeSuggestionIndex = -1;

    if (!suggestionItems.length) {
      closeAddressSuggestions();
      return;
    }

    addressSuggestions.innerHTML = "";

    suggestionItems.forEach((item, index) => {
      const button =
        document.createElement("button");

      button.type = "button";
      button.className =
        "address-suggestion";
      button.setAttribute(
        "role",
        "option"
      );
      button.setAttribute(
        "aria-selected",
        "false"
      );

      const strong =
        document.createElement("strong");

      strong.textContent =
        item.address || "";

      const small =
        document.createElement("small");

      const locationParts = [
        item.city,
        item.county,
        item.state,
        item.postal_code
      ].filter(Boolean);

      small.textContent =
        locationParts.join(", ");

      button.appendChild(strong);

      if (small.textContent) {
        button.appendChild(small);
      }

      button.addEventListener(
        "mousedown",
        (event) => {
          event.preventDefault();
          selectAddressSuggestion(index);
        }
      );

      addressSuggestions.appendChild(button);
    });

    addressSuggestions.hidden = false;

    addressInput.setAttribute(
      "aria-expanded",
      "true"
    );
  }

  async function fetchAddressSuggestions() {
    if (!addressInput) {
      return;
    }

    const query =
      addressInput.value.trim();

    if (query.length < 3) {
      closeAddressSuggestions();
      return;
    }

    if (suggestionAbortController) {
      suggestionAbortController.abort();
    }

    suggestionAbortController =
      new AbortController();

    try {
      const response =
        await fetch(
          `${API_BASE}/property-intelligence/suggest?q=${encodeURIComponent(query)}`,
          {
            method: "GET",
            signal:
              suggestionAbortController.signal
          }
        );

      if (!response.ok) {
        closeAddressSuggestions();
        return;
      }

      const data =
        await response.json();

      renderAddressSuggestions(
        data.suggestions || []
      );

    } catch (error) {
      if (
        error?.name !==
        "AbortError"
      ) {
        closeAddressSuggestions();
      }
    }
  }

  addressInput?.addEventListener(
    "input",
    () => {
      window.clearTimeout(
        suggestionTimer
      );

      suggestionTimer =
        window.setTimeout(
          fetchAddressSuggestions,
          220
        );
    }
  );

  addressInput?.addEventListener(
    "keydown",
    (event) => {
      if (
        addressSuggestions?.hidden ||
        !suggestionItems.length
      ) {
        return;
      }

      if (event.key === "ArrowDown") {
        event.preventDefault();

        activeSuggestionIndex =
          Math.min(
            activeSuggestionIndex + 1,
            suggestionItems.length - 1
          );

      } else if (event.key === "ArrowUp") {
        event.preventDefault();

        activeSuggestionIndex =
          Math.max(
            activeSuggestionIndex - 1,
            0
          );

      } else if (event.key === "Enter") {
        if (
          activeSuggestionIndex >= 0
        ) {
          event.preventDefault();
          selectAddressSuggestion(
            activeSuggestionIndex
          );
          return;
        }

        return;
      } else if (event.key === "Escape") {
        closeAddressSuggestions();
        return;
      } else {
        return;
      }

      const buttons =
        addressSuggestions.querySelectorAll(
          ".address-suggestion"
        );

      buttons.forEach(
        (button, index) => {
          const active =
            index ===
            activeSuggestionIndex;

          button.classList.toggle(
            "is-active",
            active
          );

          button.setAttribute(
            "aria-selected",
            String(active)
          );
        }
      );
    }
  );

  document.addEventListener(
    "click",
    (event) => {
      if (
        !addressInput ||
        !addressSuggestions
      ) {
        return;
      }

      if (
        event.target === addressInput ||
        addressSuggestions.contains(
          event.target
        )
      ) {
        return;
      }

      closeAddressSuggestions();
    }
  );


  const heroZoning = document.querySelector("#hero-zoning");
  const heroFlood = document.querySelector("#hero-flood");
  const heroWetlands = document.querySelector("#hero-wetlands");
  const heroBuildability = document.querySelector("#hero-buildability");
  const heroExecutiveFinding = document.querySelector(
    "#hero-executive-finding"
  );

    function renderPropertyMap({
    latitude,
    longitude,
    rings,
    address,
    parcelId
  }) {

    if (
      !propertyMapSection ||
      !propertyMapMount
    ) {
      return;
    }

    if (
      !Number.isFinite(latitude) ||
      !Number.isFinite(longitude)
    ) {
      propertyMapSection.hidden = true;
      return;
    }

    propertyMapSection.hidden = false;

    if (propertyMapInstance) {
      propertyMapInstance.remove();
      propertyMapInstance = null;
    }

    propertyMapMount.innerHTML = "";

    const mapElement =
      document.createElement("div");

    mapElement.className =
      "property-map-runtime";

    propertyMapMount.appendChild(
      mapElement
    );
    
propertyMapInstance =
  L.map(mapElement, {
    scrollWheelZoom: true,
    zoomControl: true,
    doubleClickZoom: true,
    touchZoom: true,
    dragging: true
  }).setView(
    [latitude, longitude],
    17
  );

    L.tileLayer(
      "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
      {
        attribution:
          "&copy; OpenStreetMap contributors",
        maxZoom: 19
      }
    ).addTo(
      propertyMapInstance
    );

    const marker =
      L.marker([
        latitude,
        longitude
      ]).addTo(
        propertyMapInstance
      );

    marker.bindPopup(`
      <div class="midra-map-popup">
        <strong>MIDRA Property</strong>
        <span>${address}</span>
        ${
          parcelId
            ? `<br /><small>Parcel: ${parcelId}</small>`
            : ""
        }
      </div>
    `);

    const validRings =
      Array.isArray(rings)
        ? rings.filter(
            (ring) =>
              Array.isArray(ring) &&
              ring.length >= 3
          )
        : [];

    if (validRings.length) {

      const polygonCoordinates =
        validRings.map(
          (ring) =>
            ring
              .filter(
                (point) =>
                  Array.isArray(point) &&
                  point.length >= 2 &&
                  Number.isFinite(
                    Number(point[0])
                  ) &&
                  Number.isFinite(
                    Number(point[1])
                  )
              )
              .map(
                ([lng, lat]) =>
                  [
                    Number(lat),
                    Number(lng)
                  ]
              )
        );

      const parcelPolygon =
        L.polygon(
          polygonCoordinates,
          {
            weight: 3,
            fillOpacity: 0.12
          }
        ).addTo(
          propertyMapInstance
        );

      parcelPolygon.bindPopup(`
        <div class="midra-map-popup">
          <strong>Resolved Property Parcel</strong>
          <span>${address}</span>
          ${
            parcelId
              ? `<br /><small>Parcel: ${parcelId}</small>`
              : ""
          }
        </div>
      `);

    propertyMapInstance.fitBounds(
  parcelPolygon.getBounds(),
  {
    padding: [45, 45],
    maxZoom: 16
  }
  );

    } else {

      propertyMapInstance.setView(
        [latitude, longitude],
        17
      );

    }

    window.setTimeout(() => {
      propertyMapInstance?.invalidateSize();
    }, 100);
  }
  const goalLabels = {
    buy: "Buy Property",
    pool: "Build a Pool",
    addition: "Home Addition",
    garage: "Garage",
    deck: "Deck / Patio",
    new_home: "Build a New Home",
    adu: "Build an ADU",
    driveway: "Driveway",
    subdivide: "Subdivide",
    invest: "Investment",
    other: "Something Else"
  };


  form?.addEventListener("submit", async (event) => {

    event.preventDefault();

    const input = document.querySelector("#address");

    const address = input?.value.trim();

    const selectedGoal = document.querySelector(
      'input[name="projectGoal"]:checked'
    );

    const projectGoal = selectedGoal?.value || "other";

    if (!address) {

      status.textContent =
        "Please enter a property address.";

      return;

    }


    status.textContent =
      "Analyzing propertyâ€¦";


    if (submitButton) {

      submitButton.disabled = true;

      submitButton.textContent =
        "Analyzingâ€¦";

    }


    try {

      const response = await fetch(
        `${API_BASE}/property-intelligence/analyze`,
        {
          method: "POST",

          headers: {
            "Content-Type": "application/json"
          },

          body: JSON.stringify({
            address: address,
            project_goal: projectGoal
          })
        }
      );


      if (!response.ok) {

        throw new Error(
          "The property intelligence service is unavailable."
        );

      }


      const data = await response.json();


      if (!data.property || !data.findings) {

        throw new Error(
          "The property intelligence response was incomplete."
        );

      }


      const findings = Array.isArray(data.findings)
        ? data.findings
        : [];


      const getFinding = (...areas) =>
        findings.find((item) =>
          areas.some((area) =>
            String(item.area || "")
              .toLowerCase()
              .includes(area)
          )
        );


      const zoning = getFinding("zoning");
      const flood = getFinding("flood");
      const wetlands = getFinding("wetland");
      const development = getFinding("development");


      /* ==========================================================
         HERO REPORT
      ========================================================== */

      if (heroZoning) {

        heroZoning.textContent =
          zoning?.status || "VERIFY";

      }


      if (heroFlood) {

        heroFlood.textContent =
          flood?.status || "VERIFY";

      }


      if (heroWetlands) {

        heroWetlands.textContent =
          wetlands?.status || "VERIFY";

      }


      if (heroBuildability) {

        heroBuildability.textContent =
          development?.status || "VERIFY";

      }


      if (heroExecutiveFinding) {

        heroExecutiveFinding.textContent =
          data.summary ||
          "Preliminary findings are translated into plain English, with clear verification flags and next steps instead of false certainty.";

      }


      /* ==========================================================
         RESULT HEADER
      ========================================================== */

      resultAddress.textContent =
        data.property.address || address;


      resultMessage.textContent =
        data.summary ||
        "Preliminary assessment completed.";


      resultGoal.textContent =
        data.project?.goal
          ? `Project goal: ${goalLabels[data.project.goal] || data.project.goal}`
          : `Project goal: ${goalLabels[projectGoal] || "Something Else"}`;


      /*
       * A successfully resolved property is not "demo data".
       * The property and parcel came from the NJ statewide
       * property services and the zoning resolver may have
       * supplied authoritative municipal evidence.
       *
       * Only use the demo label when the API explicitly
       * indicates that the property was not resolved.
       */

      resultMode.textContent =
        "PRELIMINARY";


      /* ==========================================================
         RESULT CARDS
      ========================================================== */

      resultCards.innerHTML = "";


      findings.forEach((item) => {

        const card =
          document.createElement("article");

        card.className =
          "result-card";


        const area =
          document.createElement("span");

        area.textContent =
          item.area || "";


        const statusValue =
          document.createElement("strong");

