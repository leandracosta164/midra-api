---
import Layout from "../layouts/Layout.astro";
import PropertyMap from "../components/property-intelligence/PropertyMap.astro";

const projectGoals = [
  { value: "buy", label: "Buy Property" },
  { value: "pool", label: "Build a Pool" },
  { value: "addition", label: "Home Addition" },
  { value: "garage", label: "Garage" },
  { value: "deck", label: "Deck / Patio" },
  { value: "new_home", label: "Build a New Home" },
  { value: "adu", label: "Build an ADU" },
  { value: "driveway", label: "Driveway" },
  { value: "subdivide", label: "Subdivide" },
  { value: "invest", label: "Investment" },
  { value: "other", label: "Something Else" }
];
---

<Layout
  title="MIDRA Property Intelligence | MIDRA Engineering"
  description="Preliminary property intelligence from MIDRA Engineering â€” understand zoning, flood, environmental constraints and development potential."
>

  <!-- ==========================================================
       PROPERTY INTELLIGENCE HERO
  =========================================================== -->

  <section class="pi-hero">

    <div class="container">

      <div class="pi-hero-grid">

        <div class="pi-hero-copy">

          <span class="eyebrow">
            MIDRA INTELLIGENCEâ„¢
          </span>

          <h1>
            Understand the property before you design the project.
          </h1>

          <p class="pi-intro">
            Enter a property address and tell us what you're considering.
            MIDRA organizes public property and engineering information into
            a preliminary assessment designed to help you make a better-informed decision.
          </p>

          <!-- ======================================================
               PROPERTY SEARCH
          ======================================================= -->

          <form id="property-form" class="search-card">

            <div class="form-section">

              <label for="address">
                Property address
              </label>

              <div class="search-row">

                <div class="address-autocomplete">

                  <input
                    id="address"
                    name="address"
                    type="text"
                    autocomplete="off"
                    placeholder="123 Main Street, Marlboro, NJ"
                    required
                    aria-autocomplete="list"
                    aria-controls="address-suggestions"
                    aria-expanded="false"
                  />

                  <div
                    id="address-suggestions"
                    class="address-suggestions"
                    role="listbox"
                    hidden
                  ></div>

                </div>

                <button
                  id="submit-button"
                  type="submit"
                >
                  Analyze Property
                </button>

              </div>

            </div>

            <!-- ====================================================
                 PROJECT GOAL
            ===================================================== -->

            <div class="goal-section">

              <div class="goal-heading">

                <label>
                  What are you planning?
                </label>

                <span>
                  Select one
                </span>

              </div>

              <div class="goal-grid">

                {
                  projectGoals.map((goal) => (

                    <label class="goal-option">

                      <input
                        type="radio"
                        name="projectGoal"
                        value={goal.value}
                        checked={goal.value === "buy"}
                      />

                      <span class="goal-option-label">
                        {goal.label}
                      </span>

                    </label>

                  ))
                }

              </div>

            </div>

            <small class="search-disclaimer">
              Preliminary intelligence only. Final engineering conclusions
              require professional review.
            </small>

          </form>

          <div
            id="form-status"
            class="form-status"
            role="status"
            aria-live="polite"
          >
          </div>

        </div>


        <!-- ========================================================
             REPORT PREVIEW
        ========================================================= -->

        <div class="hero-report">

          <div class="hero-report-rail">

            <strong>
              MIDRA<br />
              ENGINEERING
            </strong>

            <span>
              PROPERTY<br />
              INTELLIGENCE<br />
              REPORT
            </span>

            <small>
              PRELIMINARY PROPERTY ASSESSMENT
            </small>

          </div>

          <div class="hero-report-body">

            <span class="mini-label">
              PROPERTY INTELLIGENCE
            </span>

            <h2>
              A report built around decisions, not raw data.
            </h2>

            <div class="hero-score-grid">

              <div>
                <span>ZONING</span>
                <b id="hero-zoning">VERIFY</b>
              </div>

              <div>
                <span>FLOOD</span>
                <b id="hero-flood">VERIFY</b>
              </div>

              <div>
                <span>WETLANDS</span>
                <b id="hero-wetlands">VERIFY</b>
              </div>

              <div>
                <span>DEVELOPMENT</span>
                <b id="hero-buildability">VERIFY</b>
              </div>

            </div>

            <h4>
              EXECUTIVE FINDING
            </h4>

            <p id="hero-executive-finding">
              Preliminary findings are translated into plain English,
              with clear verification flags and next steps instead of
              false certainty.
            </p>

          </div>

        </div>

      </div>

    </div>

  </section>


  <!-- ==========================================================
       REPORT STRUCTURE
  =========================================================== -->

  <section class="pi-report" id="assessment">

    <div class="container">

      <div class="section-head">

        <span class="eyebrow">
          THE MIDRA REPORT
        </span>

        <h2>
          Everything important, organized the way an engineer thinks about a property.
        </h2>

        <p>
          The report brings together property information, zoning,
          environmental constraints, development considerations and
          recommended next steps in a format designed for real decisions.
        </p>

      </div>


      <div class="report-sections">

        <article>

          <span>01</span>

          <div>

            <h3>
              Property Overview
            </h3>

            <p>
              Address, municipality, county, block/lot, lot area,
              coordinates and key findings.
            </p>

          </div>

        </article>


        <article>

          <span>02</span>

          <div>

            <h3>
              Zoning & Development Standards
            </h3>

            <p>
              Technical requirements translated into practical
              implications for the proposed project.
            </p>

          </div>

        </article>


        <article>

          <span>03</span>

          <div>

            <h3>
              Flood & Environmental Review
            </h3>

            <p>
              Mapped constraints are separated from professional
              verification and field requirements.
            </p>

          </div>

        </article>


        <article>

          <span>04</span>

          <div>

            <h3>
              What May Be Possible
            </h3>

            <p>
              Pool, addition, garage, patio/deck, driveway,
              subdivision and other improvements with verification needs.
            </p>

          </div>

        </article>


        <article>

          <span>05</span>

          <div>

            <h3>
              Report Notes & Disclaimer
            </h3>

            <p>
              Sources, confidence, automated-vs-professional review
              and the limits of preliminary analysis.
            </p>

          </div>

        </article>

      </div>


      <!-- ========================================================
           SAMPLE REPORT
      ========================================================= -->

      <div class="download-panel">

        <div>

          <span class="mini-label">
            APPROVED VISUAL EXAMPLE
          </span>

          <h3>
            See the complete MIDRA report.
          </h3>

          <p>
            The sample report is the visual and structural reference
            for the production report.
          </p>

        </div>

        <a
          href="/reports/MIDRA_Property_Intelligence_Report_Example.pdf"
          target="_blank"
          rel="noopener"
        >
          Open sample report â†’
        </a>

      </div>

    </div>

  </section>


  <!-- ==========================================================
       LIVE / PRELIMINARY RESULT
  =========================================================== -->

  <section
    class="pi-result"
    id="result-section"
    hidden
  >

    <div class="container">

      <div class="result-shell">

        <div class="result-header">

          <div>

            <span class="eyebrow">
              PRELIMINARY ASSESSMENT
            </span>

            <h2 id="result-address">
              Property
            </h2>

            <p id="result-message"></p>

            <p
              id="result-goal"
              class="result-goal"
            >
            </p>

          </div>

          <span
            id="result-mode"
            class="mode-badge"
          >
            PRELIMINARY
          </span>

        </div>


        <div
          class="result-grid"
          id="result-cards"
        >
        </div>


        <div
          class="property-detail-panel"
          id="property-detail-panel"
          hidden
        >
          <div class="detail-panel-head">
            <span class="mini-label">PROPERTY OVERVIEW</span>
            <h3>Resolved property information</h3>
            <p>
              Information shown here comes from the property-resolution
              response. Fields are displayed only when the API provides them.
            </p>
          </div>

         <div
  class="property-detail-grid"
  id="property-detail-grid"
>
</div>

<div
  class="property-map-section"
  id="property-map-section"
  hidden
>
  <div class="detail-panel-head">
    <span class="mini-label">GIS / PROPERTY LOCATION</span>

    <h3>Property location and parcel boundary</h3>

    <p>
      The map identifies the resolved property location and,
      when available, the authoritative parcel boundary returned
      by the property-resolution service.
    </p>
  </div>

  <div id="property-map-mount"></div>
</div>

</div>

        <div
          class="project-requirements-panel"
          id="project-requirements-panel"
          hidden
        >
          <div class="detail-panel-head">
            <span class="mini-label">PROJECT-SPECIFIC INTELLIGENCE</span>
            <h3>Requirements and verification items</h3>
            <p>
              These items are shown only when the API provides
              project-specific requirements or verification information.
            </p>
          </div>

          <div
            class="project-requirements-list"
            id="project-requirements-list"
          >
          </div>
        </div>


        <div
          class="approval-pathway-panel"
          id="approval-pathway-panel"
          hidden
        >
          <div class="detail-panel-head">
            <span class="mini-label">MUNICIPAL APPROVAL PATHWAY</span>
            <h3>Approval pathway</h3>
            <p>
              This pathway is shown only when the API has registered
              project-specific evidence supporting an approval route.
              A verification state means the applicable municipal pathway
              still requires confirmation.
            </p>
          </div>

          <div
            class="approval-pathway-summary"
            id="approval-pathway-summary"
          ></div>

          <div
            class="approval-pathway-details"
            id="approval-pathway-details"
          ></div>
        </div>


        <div class="result-next">

          <div>

            <strong>
              Next step
            </strong>

            <p id="result-next-text"></p>

          </div>

          <a href="/contact">
            Request MIDRA Engineering Review â†’
          </a>

        </div>

      </div>

    </div>

  </section>


  <!-- ==========================================================
       ENGINEERING REVIEW CTA
  =========================================================== -->

  <section class="pi-cta">

    <div class="container">

      <div>

        <span class="eyebrow">
          FROM INTELLIGENCE TO ENGINEERING
        </span>

        <h2>
          When the preliminary answer matters, MIDRA Engineering can take it further.
        </h2>

      </div>

      <a href="/contact">
        Request Professional Review â†’
