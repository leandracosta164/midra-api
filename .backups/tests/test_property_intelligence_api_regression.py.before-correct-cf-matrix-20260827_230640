            True,
            True,
            True,
            "howell township:HD-4:pool",
        ),
        (
            "Marlboro Township",
            "CF",
            "pool",
            True,
            False,
            True,
            "marlboro township:CF:pool",
        ),
        (
            "Marlboro Township",
            "R-20",
            "pool",
            True,
            True,
            True,
            "marlboro township:R-20:pool",
        ),
        (
            "Marlboro Township",
            "VERIFY",
            "pool",
            True,
            False,
            False,
            None,
        ),
        (
            "Example Township",
            "R-1",
            "pool",
            False,
            False,
            False,
            None,
