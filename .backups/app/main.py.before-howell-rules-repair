# ============================================================
# HELPERS
# ============================================================

def _safe_text(value: object) -> str:
    if value is None:
        return ""
    return str(value).strip()


def _unique_text_items(
    items: list[object] | None,
) -> list[str]:
    """
    Preserve item order while removing exact duplicate
    verification/note messages.
    """
    result: list[str] = []
    seen: set[str] = set()

    for item in items or []:
        text = _safe_text(item)

        if not text:
            continue

        if text in seen:
            continue

        seen.add(text)
        result.append(text)

    return result


def _canonical_project_goal(project_goal: str) -> str:
    value = _safe_text(project_goal).lower()

    aliases = {
        "build a pool": "pool",
        "pool": "pool",
        "swimming pool": "pool",
        "install a pool": "pool",
        "in ground pool": "pool",
        "inground pool": "pool",

        "addition": "addition",
        "home addition": "addition",

        "garage": "garage",
        "detached garage": "garage",

        "shed": "shed",
        "storage shed": "shed",

        "deck": "deck",
        "deck / patio": "deck",
        "patio": "deck",

        "driveway": "driveway",

        "adu": "adu",
        "accessory dwelling": "adu",
        "accessory dwelling unit": "adu",

        "new home": "new_home",
        "new house": "new_home",
        "single family home": "new_home",

        "subdivision": "subdivision",

        "commercial": "commercial",

        "buy": "buy",
        "buy property": "buy",

        "invest": "invest",
        "investment": "invest",

        "other": "other",
    }

    if value in aliases:
        return aliases[value]

    for phrase, normalized in aliases.items():
        if phrase in value:
            return normalized

    return "other"


def _property_resolution_status(
    resolution: dict,
) -> str:
    return _safe_text(
        resolution.get("status")
    ) or "ADDRESS_NOT_RESOLVED"


def _resolved_municipality(
    resolution: dict,
    requested_municipality: str | None,
) -> str | None:
    """
    Prefer the municipality returned by the authoritative
    property resolver.

    User-provided municipality is only a fallback when the
    statewide resolver does not provide one.
    """
    resolved = (
        resolution.get("municipality")
        or (
            resolution.get("parcel") or {}
        ).get("municipality")
    )

    if resolved:
        return _safe_text(resolved)

    if requested_municipality:
        return _safe_text(
            requested_municipality
        )

    return None


def _build_property_information(
    payload: PropertyRequest,
    resolution: dict,
) -> dict:
    parcel = resolution.get(
        "parcel"
    ) or {}

    coordinates = resolution.get(
        "coordinates"
    ) or {}

    municipality = _resolved_municipality(
        resolution,
        payload.municipality,
    )

    county = (
        resolution.get("county")
        or parcel.get("county")
    )

    state = (
        resolution.get("state")
        or "New Jersey"
    )

    return {
        "address": (
            resolution.get("matched_address")
            or payload.address
        ),
        "requested_address": payload.address,
        "municipality": municipality,
        "county": county,
        "state": state,
        "coordinates": coordinates or None,
        "parcel": parcel or None,
    }


def _build_findings(
    *,
    property_resolution: dict,
    zoning_resolution: dict,
) -> list[dict]:
    property_status = _property_resolution_status(
        property_resolution
    )

    zoning_status = _safe_text(
        zoning_resolution.get(
            "zoning_district"
        )
    ) or "VERIFY"

    if property_status == "PROPERTY_RESOLVED":
        property_meaning = (
            "The address and parcel identity were resolved "
            "through New Jersey statewide property data."
        )
    else:
        property_meaning = (
            "Address and parcel identity are reported only "
            "when supported by the New Jersey statewide "
            "property services."
        )

    zoning_confidence = _safe_text(
        zoning_resolution.get(
            "confidence"
        )
    )

    if zoning_confidence == (
        "OFFICIAL_PARCEL_SPECIFIC"
    ):
        zoning_meaning = (
            "The zoning district is supported by "
            "property-specific authoritative municipal "
            "evidence for the resolved parcel."
        )

    elif zoning_status != "VERIFY":
        zoning_meaning = (
            "A zoning district was identified, but the "
            "property-specific evidence should still be "
            "reviewed before design or permitting."
        )

    else:
        zoning_meaning = (
            "The zoning district is reported only when "
            "supported by authoritative property-specific "
            "zoning evidence."
        )

    return [
        {
            "area": "Property",
            "status": property_status,
            "meaning": property_meaning,
        },
        {
            "area": "Zoning",
            "status": zoning_status,
            "meaning": zoning_meaning,
        },
        {
            "area": "Flood",
            "status": "Attention",
            "meaning": (
                "Mapped flood hazard conditions may affect "
                "portions of the property and should be "
                "evaluated against the resolved parcel before "
                "design or construction."
            ),
        },
        {
            "area": "Wetlands",
            "status": "Verify",
            "meaning": (
                "Potential mapped wetlands are an important "
                "siting constraint and may require field or "
                "agency verification."
            ),
        },
        {
            "area": "Development",
            "status": "Potential",
            "meaning": (
                "Development feasibility remains subject to "
                "the applicable zoning district, bulk "
                "requirements, environmental constraints "
                "and municipal approvals."
            ),
        },
    ]


# ============================================================
# PROPERTY-SPECIFIC ZONING MERGE
# ============================================================

def _merge_property_specific_zoning(
    *,
    zoning_intelligence: dict,
    zoning_resolution: dict,
) -> dict:
    """
    Connect property-specific zoning to the broader municipal
    zoning engine without allowing municipality-level rules to
    masquerade as parcel-specific requirements.

    Current rule:

    - If the parcel-specific zoning resolver returns a verified
      district, that district controls the reported zoning.
    - If the verified district is R-20, the existing Marlboro
      R-20/project intelligence may be retained.
    - If the verified district is something else, such as CF,
      residential R-20 requirements and residential pool rules
      must NOT be presented as though they apply to that parcel.
    - Until district-specific rules for the verified district
      are implemented, MIDRA reports the verified district and
      explicitly identifies the missing rule set.
    """

    merged = dict(
        zoning_intelligence
    )

    resolved_district = _safe_text(
        zoning_resolution.get(
            "zoning_district"
        )
    )

    resolved_confidence = _safe_text(
        zoning_resolution.get(
            "confidence"
        )
    )

    # ========================================================
    # VERIFIED PARCEL-SPECIFIC ZONING
    # ========================================================

    if (
        resolved_district
        and resolved_district != "VERIFY"
        and resolved_confidence
        == "OFFICIAL_PARCEL_SPECIFIC"
    ):

        # ----------------------------------------------------
        # Property-specific district controls.
        # ----------------------------------------------------

        merged["zoning_district"] = (
            resolved_district
        )

        if zoning_resolution.get(
            "zoning_name"
        ):
            merged["zoning_name"] = (
                zoning_resolution[
                    "zoning_name"
                ]
            )

        merged[
            "property_specific_zoning"
        ] = zoning_resolution

        # ----------------------------------------------------
        # Property-specific authoritative source controls.
        # ----------------------------------------------------

        if zoning_resolution.get(
            "source"
        ):
            merged["source"] = (
                zoning_resolution[
                    "source"
                ]
            )

        if zoning_resolution.get(
            "zoning_map_source"
        ):
            merged[
                "zoning_map_source"
            ] = zoning_resolution[
                "zoning_map_source"
            ]

        if zoning_resolution.get(
            "retrieved_at"
        ):
            merged[
                "source_retrieved_at"
            ] = zoning_resolution[
                "retrieved_at"
            ]

        # ----------------------------------------------------
        # NON-R-20 PARCEL
        # ----------------------------------------------------

        if resolved_district != "R-20":

            # Never apply R-20 residential requirements to
            # another zoning district.
            merged[
                "bulk_requirements"
            ] = []

            # Preserve project-specific requirements when the
            # municipal engine has an authoritative rule set
            # for the resolved district/project combination.
            #
            # Howell HD-4 pool requirements are municipal
            # project rules and are therefore retained here.
            if not (
                merged.get(
                    "municipality"
                ) == "Howell Township"
                and resolved_district == "HD-4"
                and merged.get(
                    "project_requirements"
                )
            ):
                merged[
                    "project_requirements"
                ] = []

            # Start from the authoritative parcel-specific
            # verification items rather than carrying the
            # broader municipal engine's generic messages.
            verification_items = list(
                zoning_resolution.get(
                    "verification_items"
                ) or []
            )

            verification_items.extend(
                [
                    (
                        "The resolved parcel is not in the "
                        "R-20 Residential District."
                    ),
                    (
                        "Municipality-level R-20 requirements "
                        "were intentionally withheld."
                    ),
                    (
                        "Residential R-20 pool requirements were "
                        "not applied because the resolved parcel "
                        "is in the "
                        f"{resolved_district} zoning district."
                    ),
                    (
                        "HD-4 bulk/dimensional standards have not "
                        "yet been loaded into MIDRA from the current "
                        "Howell Township Bulk Standards Table II."
                    ),
                ]
            )

            merged[
                "verification_items"
            ] = _unique_text_items(
                verification_items
            )

            merged[
                "confidence"
            ] = (
                "PARCEL_ZONING_RESOLVED_RULES_PENDING"
            )

            notes = list(
                zoning_resolution.get(
                    "notes"
                ) or []
            )

            notes.append(
                (
                    "Property-specific zoning controls this "
                    "assessment. Municipal R-20 rules were not "
                    "applied because the resolved district is "
                    f"{resolved_district}."
                )
            )

            merged["notes"] = (
                _unique_text_items(
                    notes
                )
            )

        # ----------------------------------------------------
        # VERIFIED R-20 PARCEL
        # ----------------------------------------------------

        else:

            verification_items = list(
                zoning_resolution.get(
                    "verification_items"
                ) or []
            )

            verification_items.append(
                (
                    "The parcel-specific zoning resolver "
                    "identified R-20. Existing Marlboro R-20 "
                    "requirements are therefore eligible to be "
                    "reported, subject to current-source "
                    "verification."
                )
            )

            merged[
                "verification_items"
            ] = _unique_text_items(
                verification_items
            )

        return merged

    # ========================================================
    # NO VERIFIED PARCEL-SPECIFIC ZONING
    # ========================================================

    merged[
        "property_specific_zoning"
    ] = zoning_resolution

    verification_items = list(
        merged.get(
            "verification_items"
        ) or []
    )

    verification_items.extend(
        zoning_resolution.get(
            "verification_items"
        ) or []
    )

    verification_items.append(
        (
            "Property-specific zoning could not be "
            "confirmed from authoritative parcel evidence."
        )
    )

    merged[
        "verification_items"
    ] = _unique_text_items(
        verification_items
    )

    return merged


