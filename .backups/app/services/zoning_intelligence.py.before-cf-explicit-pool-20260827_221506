def list_registered_municipalities() -> list[str]:
    """
    Return municipalities currently registered in the MIDRA
    zoning source registry.
    """
    return sorted(
        config["canonical_name"]
        for config in MUNICIPALITY_SOURCES.values()
    )


def get_municipality_source_config(
    municipality: str,
) -> dict[str, Any] | None:
    """
    Return the configured source metadata for a municipality.

    Intended for administrative/debugging use.
    """
    return _get_source_config(
        municipality
    )


# ============================================================
# RULES REGISTRY HELPERS
# ============================================================

def list_registered_rule_sets() -> list[str]:
    """Return configured municipality/district/project rule keys."""
    result: list[str] = []

    for municipality, config in MUNICIPAL_RULES_REGISTRY.items():
        for district in config.get("districts", {}):
            projects = config.get("projects", {})
            district_projects = []

            for project, project_config in projects.items():
                if district in project_config.get("districts", {}):
                    district_projects.append(project)

            if district_projects:
                for project in sorted(district_projects):
                    result.append(
                        f"{municipality}:{district}:{project}"
                    )
            else:
                result.append(
                    f"{municipality}:{district}"
                )

    return sorted(result)


def get_municipality_rules_config(
    municipality: str,
) -> dict[str, Any] | None:
    """Return a municipality's registered rules configuration."""
    return MUNICIPAL_RULES_REGISTRY.get(
        (municipality or "").strip().lower()
    )

