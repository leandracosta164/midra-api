# MAIN ENGINE
# ============================================================

def get_zoning_intelligence(
    municipality: str,
    project_goal: str = "other",
    property_zoning: dict[str, Any] | None = None,
) -> dict[str, Any]:
    """
    Retrieve municipal zoning intelligence and apply registered
    district/project rules.

    The core engine is intentionally generic:
        municipality -> source configuration
        property district -> rules registry
        project goal -> project rules

    A verified property-specific district is required before
    district-specific rules are applied.
    """

    requested_municipality = (
        municipality or ""
    ).strip()

    config = _get_source_config(
        requested_municipality
    )

    project = normalize_project_goal(
        project_goal
    )

    property_zoning = (
        property_zoning
        if isinstance(property_zoning, dict)
        else None
    )

    property_zoning_district = "VERIFY"

    if property_zoning:
        property_zoning_district = (
            str(
                property_zoning.get(
                    "zoning_district",
                    "VERIFY",
                )
            ).strip()
            or "VERIFY"
        )

    has_verified_property_zoning = (
        property_zoning_district.upper()
        not in {
            "",
            "VERIFY",
            "UNKNOWN",
            "NOT RESOLVED",
        }
    )

    retrieved_at = _utc_now()

    if config is None:
        return {
            "municipality": requested_municipality,
            "zoning_district": "VERIFY",
            "source": {
                "municipality": requested_municipality,
                "source_type": "NOT_REGISTERED",
                "url": None,
