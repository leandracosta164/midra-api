# ============================================================
# CODE SECTION SEARCH
# ============================================================

def _find_section_context(
    text: str,
    section: str,
    *,
    context_chars: int = 6000,
) -> str | None:
    """
    Locate a code section and return surrounding searchable
    context.

    This is intentionally conservative. If the section cannot
    be found, no requirement is generated.
    """

    if not text:
        return None

    normalized = _normalize_text(text)

    candidates = [
        section,
        section.replace("Ã‚Â§", ""),
        section.replace("Ã‚Â§", "").replace(" ", ""),
    ]

    index = -1

    for candidate in candidates:
        index = normalized.lower().find(
            candidate.lower()
        )

        if index >= 0:
            break

    if index < 0:
        return None

    start = max(
        0,
        index - 1000,
    )

    end = min(
        len(normalized),
        index + context_chars,
    )

    return normalized[start:end]


# ============================================================
# REQUIREMENT EXTRACTION
# ============================================================

def _extract_first(
    text: str,
    patterns: list[str],
) -> str | None:
    """Return the first regex capture that matches."""
    for pattern in patterns:
        match = re.search(
            pattern,
            text,
            flags=re.IGNORECASE,
        )

        if match:
            return match.group(1).strip()

    return None


def _extract_numeric_requirement(
    text: str,
    labels: list[str],
) -> str | None:
    """
    Extract simple numeric requirements when the surrounding
    source explicitly associates the number with the requested
    label.

    The engine deliberately does not guess a number from a
    nearby unrelated provision.
    """

    if not text:
        return None

    label_pattern = "|".join(
        re.escape(label)
        for label in labels
    )

    pattern = (
        rf"(?:{label_pattern})"
        rf".{{0,100}}?"
        rf"(\d+(?:\.\d+)?\s*"
        rf"(?:feet|foot|ft\.?|square feet|sq\.?\s*ft\.?|%"
        rf"|acres?))"
    )

    return _extract_first(
        text,
        [pattern],
    )


