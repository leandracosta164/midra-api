                    "has yet been registered in MIDRA."
                ),
                "authoritative": False,
            },
            "bulk_requirements": [],
            "project_requirements": [],
            "permitted_uses": [],
            "conditional_uses": [],
            "property_zoning": property_zoning,
            "verification_items": [
                (
                    "Municipality is not yet registered in the "
                    "MIDRA zoning source registry."
                ),
