            )

        if rules_registry["project_rules_available"]:
            verification_items.append(
                "Project-specific rules are available for the resolved "
                "municipality/district/project combination."
            )

        return {
            "municipality": config["canonical_name"],
            "zoning_district": zoning_district,
            "source": source,
            "property_zoning": property_zoning,
            "bulk_requirements": bulk_requirements,
            "project_requirements": project_requirements,
