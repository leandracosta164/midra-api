# MUNICIPAL RULES REGISTRY
# ============================================================
#
# The source registry answers:
#     "Where is this municipality's authoritative zoning source?"
#
# This rules registry answers:
#     "Once the property district is verified, which rules apply?"
#
# Keeping those concerns separate allows new municipalities and
# districts to be added without modifying the core engine.
# ============================================================

MUNICIPAL_RULES_REGISTRY: dict[str, dict[str, Any]] = {
    "howell township": {
        "districts": {
            "HD-4": {
                "bulk": _build_howell_hd4_bulk_requirements,
                "description": "Howell Township Highway Development 4 district.",
            },
        },
        "projects": {
            "pool": {
                "districts": {
                    "HD-4": _build_howell_pool_requirements,
                },
            },
        },
    },
    "marlboro township": {
        "districts": {
            "R-20": {
                "bulk": _build_marlboro_r20_requirements,
                "description": "Marlboro Township R-20 Residential District.",
            },
            "CF": {
                "description": "Marlboro Township Community Facilities District.",
            },
        },
        "projects": {
            "pool": {
                "districts": {
                    "R-20": _build_marlboro_pool_requirements,
                    "VERIFY": _build_marlboro_pool_requirements,
                },
            },
        },
    },
}


def _get_registered_rule_set(
    municipality: str,
    district: str,
    project: str,
) -> dict[str, Any]:
    """
    Resolve the applicable rules without municipality-specific
    conditionals in the core engine.

    Returns a small execution plan containing only rules that
    actually match the verified municipality/district/project.
    """
    municipality_key = (
        municipality or ""
    ).strip().lower()

    district_key = (
        district or "VERIFY"
    ).strip().upper()

    project_key = normalize_project_goal(
        project
    )

    municipality_rules = MUNICIPAL_RULES_REGISTRY.get(
        municipality_key
    )

    if municipality_rules is None:
        return {
            "registered": False,
            "district_registered": False,
            "bulk_handler": None,
            "project_handler": None,
            "rule_key": None,
        }

    district_config = (
        municipality_rules.get("districts", {}).get(
            district_key
        )
    )

    project_config = (
        municipality_rules.get("projects", {}).get(
            project_key
        )
    )

    project_handler = None

    if project_config:
        project_handler = (
            project_config.get("districts", {}).get(
                district_key
            )
        )

        if project_handler is None:
            project_handler = (
                project_config.get("districts", {}).get(
                    "VERIFY"
                )
            )

    return {
        "registered": True,
        "district_registered": (
            district_config is not None
        ),
        "bulk_handler": (
            district_config.get("bulk")
            if district_config
            else None
        ),
        "project_handler": project_handler,
        "rule_key": (
            f"{municipality_key}:{district_key}:{project_key}"
            if district_config or project_handler
            else None
        ),
    }


def _apply_registered_rules(
    *,
    municipality: str,
    district: str,
    project: str,
    source_text: str | None,
    source_url: str,
    bulk_requirements: list[dict[str, Any]],
    project_requirements: list[dict[str, Any]],
) -> tuple[
    list[dict[str, Any]],
    list[dict[str, Any]],
    dict[str, Any],
]:
    """
    Apply the data-driven district/project rules registry.

    Existing source retrieval remains responsible for general
    municipal information. The registry is responsible only for
    rules that are tied to the verified district and project.
    """
    rule_set = _get_registered_rule_set(
        municipality,
        district,
        project,
    )

    bulk_handler = rule_set.get("bulk_handler")

    if bulk_handler is not None:
        bulk_requirements = list(
            bulk_handler(
                source_text=source_text,
                source_url=source_url,
            )
        )

    project_handler = rule_set.get(
        "project_handler"
    )

    if project_handler is not None:
        project_requirements = list(
            project_handler(
                source_text=source_text,
                source_url=source_url,
            )
        )

    return (
        bulk_requirements,
        project_requirements,
        {
            "registered": bool(
                rule_set.get("registered")
            ),
            "district_registered": bool(
                rule_set.get(
                    "district_registered"
                )
            ),
            "rule_key": rule_set.get(
                "rule_key"
            ),
            "project_rules_available": bool(
                project_handler is not None
            ),
            "district_rules_available": bool(
                bulk_handler is not None
            ),
        },
    )




