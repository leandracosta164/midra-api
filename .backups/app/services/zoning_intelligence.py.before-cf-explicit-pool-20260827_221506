            ],
            "source_retrieved_at": retrieved_at,
            "confidence": "SOURCE_NOT_REGISTERED",
            "rules_registry": {
                "registered": False,
                "district_registered": False,
                "district_rules_available": False,
                "project_rules_available": False,
                "rule_key": None,
            },
            "notes": [],
        }

    ecode_config = config.get(
        "ecode",
        {},
    )

    ecode_text, ecode_meta = _retrieve_ecode_source(
        config
    )

    ecode_status = _retrieval_status(
        ecode_meta
    )

    zoning_district = (
        property_zoning_district
        if has_verified_property_zoning
        else "VERIFY"
    )

    if ecode_text:
        source_url = ecode_meta.get(
            "url",
            ecode_config.get("url"),
        )

        source = _source_metadata(
            municipality=config["canonical_name"],
            source_type="eCode360",
            url=source_url,
            description=ecode_config.get(
                "description",
                "Municipal zoning code.",
