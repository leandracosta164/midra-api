    connect=10.0,
    read=30.0,
    write=10.0,
    pool=10.0,
)

USER_AGENT = (
    "MIDRA-Engineering-Property-Intelligence/1.0 "
    "(NJ address and parcel resolution)"
)

# Controlled search distances in meters.
#
# We start very close to the geocoded point and expand only
# when necessary. This reduces the chance of selecting an
# unrelated neighboring parcel.
PARCEL_SEARCH_DISTANCES_METERS = (
    5,
    15,
    30,
    50,
)


# ============================================================
# HELPERS
# ============================================================

def _utc_now() -> str:
    return datetime.now(timezone.utc).isoformat()


def _headers() -> dict[str, str]:
    return {
        "User-Agent": USER_AGENT,
        "Accept": "application/json",
    }


def _safe_float(value: Any) -> float | None:
    try:
        if value is None:
            return None

        return float(value)

    except (TypeError, ValueError):
        return None


def _clean(value: Any) -> str | None:
    if value is None:
        return None

    text = str(value).strip()

    return text or None


def _normalize_text(value: Any) -> str:
    if value is None:
        return ""

    return " ".join(
        str(value)
        .strip()
        .upper()
        .split()
    )


def _extract_house_number(value: Any) -> str:
    text = _normalize_text(value)

    if not text:
        return ""

    parts = text.split()

    if not parts:
        return ""

    first = parts[0]

    digits = ""

    for char in first:
        if char.isdigit():
            digits += char
        else:
            break

    return digits


def _normalize_street(value: Any) -> str:
    text = _normalize_text(value)

    if not text:
        return ""

    replacements = {
        "STATE HIGHWAY": "ROUTE",
        "STATE HWY": "ROUTE",
        "HIGHWAY": "ROUTE",
        "HWY": "ROUTE",
        "NJ ROUTE": "ROUTE",
        "NJ-": "ROUTE ",
        "N J ROUTE": "ROUTE",
        "ROAD": "RD",
        "STREET": "ST",
        "AVENUE": "AVE",
        "DRIVE": "DR",
        "BOULEVARD": "BLVD",
        "LANE": "LN",
        "COURT": "CT",
        "PARKWAY": "PKWY",
        "TURNPIKE": "TPKE",
    }

    for source, target in replacements.items():
        text = text.replace(source, target)

    return " ".join(text.split())


def _street_tokens(value: Any) -> set[str]:
    text = _normalize_street(value)

    if not text:
        return set()

    tokens = text.split()

    # Remove the house number from street comparison.
    if tokens and tokens[0].isdigit():
        tokens = tokens[1:]

    return set(tokens)


def _point_in_ring(
    longitude: float,
    latitude: float,
    ring: list[list[float]],
) -> bool:

    inside = False

    if len(ring) < 3:
        return False

    j = len(ring) - 1

    for i in range(len(ring)):

        xi = float(ring[i][0])
        yi = float(ring[i][1])

        xj = float(ring[j][0])
        yj = float(ring[j][1])

        intersects = (
            (yi > latitude) != (yj > latitude)
            and longitude
            < (
                (xj - xi)
                * (latitude - yi)
                / ((yj - yi) or 1e-12)
                + xi
            )
        )

        if intersects:
            inside = not inside

        j = i

    return inside


def _point_in_parcel_geometry(
    geometry: dict[str, Any],
    *,
    longitude: float,
    latitude: float,
) -> bool:

    rings = geometry.get(
        "rings",
        [],
    )

    if not rings:
        return False

    return any(
        _point_in_ring(
            longitude,
            latitude,
            ring,
        )
        for ring in rings
        if isinstance(ring, list)
    )


