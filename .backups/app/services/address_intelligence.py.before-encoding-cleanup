def _query_parcels(
    *,
    longitude: float,
    latitude: float,
    distance_meters: float,
) -> dict[str, Any]:

    geometry = (
        f"{longitude},{latitude}"
    )

    params = {
        "f": "json",

        "geometry": geometry,

        "geometryType": (
            "esriGeometryPoint"
        ),

        "inSR": "4326",

        "spatialRel": (
            "esriSpatialRelIntersects"
        ),

        "distance": distance_meters,

        "units": "esriSRUnit_Meter",

        "outFields": PARCEL_OUT_FIELDS,

        "returnGeometry": "true",

        "outSR": "4326",

        "returnTrueCurves": "false",

        "returnCentroid": "true",

        "resultRecordCount": 25,

        "orderByFields": (
            "OBJECTID ASC"
        ),
    }

    try:

        with httpx.Client(
            timeout=REQUEST_TIMEOUT,
            follow_redirects=True,
            headers=_headers(),
        ) as client:

            response = client.get(
                PARCEL_QUERY_URL,
                params=params,
            )

            response.raise_for_status()

            data = response.json()

    except httpx.HTTPError as exc:

        return {
            "status": "PARCEL_SERVICE_ERROR",
            "features": [],
            "notes": [
                f"NJ parcel service request failed: {exc}"
            ],
        }

    except ValueError as exc:

        return {
            "status": "PARCEL_INVALID_RESPONSE",
            "features": [],
            "notes": [
                f"NJ parcel service returned invalid JSON: {exc}"
            ],
        }

    if "error" in data:

        return {
            "status": "PARCEL_QUERY_ERROR",
            "features": [],
            "notes": [
                str(
                    data["error"]
                )
            ],
        }

    features = data.get(
        "features",
        [],
    )

    return {
        "status": (
            "PARCELS_FOUND"
            if features
            else "NO_PARCELS_FOUND"
        ),
        "features": features,
        "notes": [],
    }


