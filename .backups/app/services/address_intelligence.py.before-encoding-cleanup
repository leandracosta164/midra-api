def _score_parcel(
    feature: dict[str, Any],
    *,
    geocoded_city: str | None,
    geocoded_zip: str | None,
    geocoded_address: str | None,
    longitude: float | None = None,
    latitude: float | None = None,
    search_distance_meters: float | None = None,
) -> int:

    parcel = _normalize_parcel(
        feature
    )

    score = 0

    parcel_city = _normalize_text(
        parcel.get(
            "city_state"
        )
    )

    parcel_address = _normalize_text(
        parcel.get(
            "street_address"
        )
    )

    parcel_location = _normalize_text(
        parcel.get(
            "property_location"
        )
    )

    parcel_zip = _normalize_text(
        parcel.get(
            "zip5"
        )
    )

    target_city = _normalize_text(
        geocoded_city
    )

    target_zip = _normalize_text(
        geocoded_zip
    )

    target_address = _normalize_text(
        geocoded_address
    )

    # --------------------------------------------------------
    # ZIP agreement
    # --------------------------------------------------------

    if (
        target_zip
        and parcel_zip
        and target_zip == parcel_zip
    ):
        score += 20

    # --------------------------------------------------------
    # Municipality / postal city agreement
    #
    # A mismatch is intentionally NOT penalized.
    #
    # Postal municipality and tax/GIS municipality can differ.
    # --------------------------------------------------------

    if (
        target_city
        and parcel_city
        and target_city in parcel_city
    ):
        score += 10

    # --------------------------------------------------------
    # House number agreement
    # --------------------------------------------------------

    target_house = _extract_house_number(
        target_address
    )

    parcel_house = _extract_house_number(
        parcel_address
    )

    location_house = _extract_house_number(
        parcel_location
    )

    if (
        target_house
        and (
            target_house == parcel_house
            or target_house == location_house
        )
    ):
        score += 20

    # --------------------------------------------------------
    # Street / route agreement
    #
    # Handles variations such as:
    #
    # STATE HIGHWAY 33
    # STATE HWY 33
    # ROUTE 33
    # NJ-33
    # --------------------------------------------------------

    target_streets = _street_tokens(
        target_address
    )

    parcel_streets = (
        _street_tokens(parcel_address)
        | _street_tokens(parcel_location)
    )

    if (
        target_streets
        and parcel_streets
    ):

        common_tokens = (
            target_streets
            & parcel_streets
        )

        if common_tokens:
            score += 20

    # --------------------------------------------------------
    # Spatial evidence
    #
    # This is intentionally the strongest signal.
    # --------------------------------------------------------

    if (
        longitude is not None
        and latitude is not None
    ):

        geometry = parcel.get(
            "geometry",
            {}
        )

        if _point_in_parcel_geometry(
            geometry,
            longitude=longitude,
            latitude=latitude,
        ):
            score += 35

    # --------------------------------------------------------
    # Controlled proximity evidence
    #
    # This is useful when the geocoder point lands on a road,
    # driveway, or frontage just outside the parcel polygon.
    # --------------------------------------------------------

    if search_distance_meters is not None:

        if search_distance_meters <= 5:
            score += 20

        elif search_distance_meters <= 15:
            score += 15

        elif search_distance_meters <= 30:
            score += 8

    # --------------------------------------------------------
    # Parcel identifiers
    # --------------------------------------------------------

    if parcel.get(
        "pams_pin"
    ):
        score += 5

    if (
        parcel.get("block")
        and parcel.get("lot")
    ):
        score += 5

    return min(
        score,
        100,
    )


# ============================================================
# FIND PARCEL BY POINT
# ============================================================

def find_parcel_by_point(
    longitude: float,
    latitude: float,
    *,
    geocoded_city: str | None = None,
    geocoded_zip: str | None = None,
    geocoded_address: str | None = None,
) -> dict[str, Any]:
    """
    Find the NJ statewide parcel associated with a geocoded
    property location.

    Strategy
    --------
    1. Search a very small radius first.
    2. Expand gradually if necessary.
    3. Score returned parcels against the geocoder's city,
       ZIP and matched address.
    4. Only return a parcel when the evidence is sufficient.

    This prevents a nearby but unrelated parcel from being
    silently assigned to the property.
    """

    retrieved_at = _utc_now()

    all_candidates: list[
        dict[str, Any]
    ] = []

    successful_distances: list[
        float
    ] = []

    for distance in PARCEL_SEARCH_DISTANCES_METERS:

        result = _query_parcels(
            longitude=longitude,
            latitude=latitude,
            distance_meters=distance,
        )

        if result["status"] in {
            "PARCEL_SERVICE_ERROR",
            "PARCEL_INVALID_RESPONSE",
            "PARCEL_QUERY_ERROR",
        }:

            return {
                "status": result["status"],
                "retrieved_at": retrieved_at,
                "parcel": None,
                "notes": result.get(
                    "notes",
                    [],
                ),
            }

        features = result.get(
            "features",
            [],
        )

        if not features:
            continue

        successful_distances.append(
            distance
        )

        for feature in features:

            normalized = _normalize_parcel(
                feature
            )

            candidate_score = _score_parcel(
                feature,
                geocoded_city=geocoded_city,
                geocoded_zip=geocoded_zip,
                geocoded_address=geocoded_address,
                longitude=longitude,
                latitude=latitude,
                search_distance_meters=distance,
            )

            all_candidates.append(
                {
                    "score": candidate_score,
                    "search_distance_meters": distance,
                    "parcel": normalized,
                }
            )

        # Once a close search has returned plausible candidates,
        # do not unnecessarily search a much larger radius.
        #
        # A high-confidence address match should be resolved
        # locally whenever possible.

        close_candidates = [
            candidate
            for candidate in all_candidates
            if candidate["search_distance_meters"]
            <= 15
        ]

        if close_candidates:
            break

    if not all_candidates:

        return {
            "status": "NO_PARCEL_MATCH",
            "retrieved_at": retrieved_at,
            "parcel": None,
            "notes": [
                (
                    "No statewide parcel polygon was found "
                    "within the controlled search distances "
                    "around the resolved address."
                )
            ],
        }

    # --------------------------------------------------------
    # Sort:
    #
    # 1. strongest address/city/ZIP evidence
    # 2. shortest search distance
    # --------------------------------------------------------

    all_candidates.sort(
        key=lambda item: (
            -item["score"],
            item["search_distance_meters"],
        )
    )

    best = all_candidates[0]

    best_score = best["score"]

    # --------------------------------------------------------
    # Minimum confidence threshold
    # --------------------------------------------------------
    #
    # We require meaningful evidence before assigning a
    # property parcel.
    #
    # Address + ZIP agreement can produce a strong match.
    # If neither exists, we refuse to guess.
    # --------------------------------------------------------

    if best_score < 35:

        return {
            "status": "PARCEL_MATCH_REQUIRES_REVIEW",
            "retrieved_at": retrieved_at,
            "parcel": None,
            "candidates": [
                {
                    "score": item["score"],
                    "search_distance_meters": item[
                        "search_distance_meters"
                    ],
                    "parcel": item["parcel"],
                }
                for item in all_candidates[:10]
            ],
            "notes": [
                (
                    "Nearby parcels were found, but the "
                    "available parcel attributes did not "
                    "provide sufficient evidence to safely "
                    "assign one to the requested address."
                ),
                (
                    "MIDRA will not guess the parcel."
                ),
            ],
        }

    return {
        "status": "PARCEL_FOUND",
        "retrieved_at": retrieved_at,
        "parcel": best["parcel"],
        "match_score": best_score,
        "search_distance_meters": (
            best["search_distance_meters"]
        ),
        "candidate_count": len(
            all_candidates
        ),
        "source": {
            "source_type": "NJ Office of GIS",
            "service": (
                "Parcels and MOD-IV Composite of New Jersey"
            ),
            "url": PARCEL_QUERY_URL,
            "authoritative": True,
        },
        "notes": [
            (
                "Parcel was identified using the NJ Office "
                "of GIS statewide parcel layer."
            ),
            (
                "The search used a controlled spatial radius "
                "around the NJ statewide geocoded address."
            ),
        ],
    }


# ============================================================
# COMPLETE ADDRESS â†’ PARCEL RESOLUTION
# ============================================================

def resolve_new_jersey_property(
    address: str,
) -> dict[str, Any]:
    """
    Complete NJ address resolution.

    Flow:

        address
          â†“
        statewide geocoder
          â†“
        coordinates
          â†“
        statewide parcel search
          â†“
        municipality / county / block / lot
    """

    resolved_at = _utc_now()

    geocode = geocode_new_jersey_address(
        address
    )

    selected = geocode.get(
        "selected"
    )

    if not selected:

        return {
            "status": "ADDRESS_NOT_RESOLVED",

            "requested_address": address,

            "resolved_at": resolved_at,

            "geocoding": geocode,

            "parcel": None,

            "municipality": None,

            "county": None,

            "coordinates": None,

            "verification_items": [
                (
                    "The address could not be confidently "
                    "resolved using the NJ statewide geocoder."
                ),
                (
                    "Parcel and zoning analysis cannot be "
                    "considered property-specific until the "
                    "address is resolved."
                ),
            ],
        }

    longitude = selected.get(
        "x"
    )

    latitude = selected.get(
        "y"
    )

    if longitude is None or latitude is None:

        return {
            "status": "GEOCODE_NO_COORDINATES",

            "requested_address": address,

            "resolved_at": resolved_at,

            "geocoding": geocode,

            "parcel": None,

            "municipality": None,

            "county": None,

            "coordinates": None,

            "verification_items": [
                (
                    "The NJ geocoder returned a candidate "
                    "without usable coordinates."
                ),
            ],
        }

    parcel_result = find_parcel_by_point(
        longitude=longitude,
        latitude=latitude,
        geocoded_city=selected.get(
            "city"
        ),
        geocoded_zip=selected.get(
            "postal_code"
        ),
        geocoded_address=selected.get(
            "match_address"
        ),
    )

    parcel = parcel_result.get(
        "parcel"
    )

    # --------------------------------------------------------
    # Parcel not found
    # --------------------------------------------------------

    if not parcel:

        return {
            "status": (
                "ADDRESS_RESOLVED_PARCEL_NOT_FOUND"
                if parcel_result.get(
                    "status"
                ) == "NO_PARCEL_MATCH"
                else parcel_result.get(
                    "status",
                    "ADDRESS_RESOLVED_PARCEL_REVIEW",
                )
            ),

            "requested_address": address,

            "resolved_at": resolved_at,

            "matched_address": selected.get(
                "match_address"
            ),

            "match_score": selected.get(
                "score"
            ),

            "geocoding": geocode,

            "parcel": None,

            "municipality": selected.get(
                "city"
            ),

            "county": selected.get(
                "county"
            ),

            "coordinates": {
                "longitude": longitude,
                "latitude": latitude,
            },

            "verification_items": [
                (
                    "The address was successfully geocoded, "
                    "but a sufficiently supported parcel "
                    "could not yet be assigned."
                ),
                (
                    "Parcel-specific zoning analysis should "
                    "not proceed until the parcel is confirmed."
                ),
            ],

            "parcel_service": parcel_result,
        }

    # --------------------------------------------------------
    # Property resolved
    # --------------------------------------------------------

    municipality = (
        parcel.get(
            "municipality"
        )
        or selected.get(
            "city"
        )
    )

    county = (
        parcel.get(
            "county"
        )
        or selected.get(
            "county"
        )
    )

    return {
        "status": "PROPERTY_RESOLVED",

        "requested_address": address,

        "resolved_at": resolved_at,

        "matched_address": selected.get(
            "match_address"
        ),

        "match_score": selected.get(
            "score"
        ),

        "coordinates": {
            "longitude": longitude,
            "latitude": latitude,
        },

        "municipality": municipality,

        "county": county,

        "state": (
            selected.get(
                "state"
            )
            or "New Jersey"
        ),

        "parcel": parcel,

        "geocoding": {
            "status": geocode.get(
                "status"
            ),

            "source": geocode.get(
                "source"
            ),
        },

        "parcel_source": parcel_result.get(
            "source"
        ),

        "parcel_match": {
            "score": parcel_result.get(
                "match_score"
            ),

            "search_distance_meters": (
                parcel_result.get(
                    "search_distance_meters"
                )
            ),

            "candidate_count": (
                parcel_result.get(
                    "candidate_count"
                )
            ),
        },

        "verification_items": [
            (
                "Parcel identity is based on the NJ Office "
                "of GIS statewide geocoder and parcel layer."
            ),
            (
                "The zoning district still requires a "
                "separate authoritative zoning-map lookup."
            ),
        ],

        "notes": [
            (
                "This resolver does not determine zoning."
            ),
            (
                "This resolver does not determine legal "
                "ownership or development entitlement."
            ),
        ],
    }
    
