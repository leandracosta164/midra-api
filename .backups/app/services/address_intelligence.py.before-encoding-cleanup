def geocode_new_jersey_address(
    address: str,
) -> dict[str, Any]:
    """
    Resolve a New Jersey address using the official
    NJ Office of GIS statewide geocoder.

    Returns the best candidate together with its score
    and coordinates.
    """

    retrieved_at = _utc_now()

    if not address or len(address.strip()) < 3:
        return {
            "status": "INVALID_ADDRESS",
            "address": address,
            "retrieved_at": retrieved_at,
            "candidates": [],
            "selected": None,
            "notes": [
                "Address must contain at least three characters."
            ],
        }

    params = {
        "SingleLine": address.strip(),
        "f": "json",
        "outFields": "*",
        "maxLocations": 5,
        "outSR": 4326,
        "forStorage": "false",
    }

    try:

        with httpx.Client(
            timeout=REQUEST_TIMEOUT,
            follow_redirects=True,
            headers=_headers(),
        ) as client:

            response = client.get(
                GEOCODER_URL,
                params=params,
            )

            response.raise_for_status()

            data = response.json()

    except httpx.HTTPError as exc:

        return {
            "status": "GEOCODER_ERROR",
            "address": address,
            "retrieved_at": retrieved_at,
            "candidates": [],
            "selected": None,
            "notes": [
                f"NJ statewide geocoder request failed: {exc}"
            ],
        }

    except ValueError as exc:

        return {
            "status": "GEOCODER_INVALID_RESPONSE",
            "address": address,
            "retrieved_at": retrieved_at,
            "candidates": [],
            "selected": None,
            "notes": [
                f"NJ geocoder returned invalid JSON: {exc}"
            ],
        }

    candidates = data.get(
        "candidates",
        [],
    )

    if not candidates:

        return {
            "status": "NO_MATCH",
            "address": address,
            "retrieved_at": retrieved_at,
            "candidates": [],
            "selected": None,
            "notes": [
                "No NJ statewide geocoding candidate was found."
            ],
        }

    normalized_candidates: list[
        dict[str, Any]
    ] = []

    for candidate in candidates:

        location = candidate.get(
            "location",
            {},
        )

        attributes = candidate.get(
            "attributes",
            {},
        )

        normalized_candidates.append(
            {
                "match_address": _clean(
                    attributes.get(
                        "Match_addr"
                    )
                ),

                "score": _safe_float(
                    candidate.get(
                        "score"
                    )
                ),

                "status": _clean(
                    attributes.get(
                        "Status"
                    )
                ),

                "city": _clean(
                    attributes.get(
                        "City"
                    )
                ),

                "county": _clean(
                    attributes.get(
                        "Subregion"
                    )
                ),

                "state": _clean(
                    attributes.get(
                        "Region"
                    )
                ),

                "postal_code": _clean(
                    attributes.get(
                        "Postal"
                    )
                ),

                "x": _safe_float(
                    location.get(
                        "x"
                    )
                ),

                "y": _safe_float(
                    location.get(
                        "y"
                    )
                ),
            }
        )

    selected = normalized_candidates[0]

    score = selected.get(
        "score"
    )

    if score is not None and score >= 95:
        status = "HIGH_CONFIDENCE"

    elif score is not None and score >= 85:
        status = "GOOD_MATCH"

    elif score is not None and score >= 70:
        status = "REVIEW_MATCH"

    else:
        status = "LOW_CONFIDENCE"

    return {
        "status": status,
        "address": address,
        "retrieved_at": retrieved_at,
        "candidates": normalized_candidates,
        "selected": selected,
        "source": {
            "source_type": "NJ Office of GIS",
            "service": "NJ_Geocode",
            "url": GEOCODER_URL,
            "authoritative": True,
        },
        "notes": [
            (
                "Address resolution uses the New Jersey "
                "statewide geocoding service."
            ),
        ],
    }


