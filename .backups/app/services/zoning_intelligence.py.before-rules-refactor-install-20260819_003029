def _get_source_config(
    municipality: str,
) -> dict[str, Any] | None:
    """
    Find a municipality in the source registry.

    NJ parcel/geocoder services commonly return abbreviated
    municipality names such as:

        MARLBORO TWP
        HOWELL TWP

    MIDRA stores canonical registry names such as:

        marlboro township
        howell township

    Normalize those variants before performing the registry
    lookup.
    """

    key = (
        municipality or ""
    ).strip().lower()

    aliases = {
        "marlboro": "marlboro township",
        "marlboro twp": "marlboro township",
        "marlboro township": "marlboro township",

        "howell": "howell township",
        "howell twp": "howell township",
        "howell township": "howell township",
    }

    key = aliases.get(
        key,
        key,
    )

    if key in MUNICIPALITY_SOURCES:
        return MUNICIPALITY_SOURCES[key]

    normalized = re.sub(
        r"\s+",
        " ",
        key,
    )

    return MUNICIPALITY_SOURCES.get(
        normalized
    )


