# MAIN ENGINE
# ============================================================

def get_zoning_intelligence(
    municipality: str,
    project_goal: str = "other",
    property_zoning: dict[str, Any] | None = None,
) -> dict[str, Any]:
    """
    Retrieve zoning intelligence for a municipality.

    Important:
    This function can accept a property-specific zoning result
    from the separate address/parcel/zoning resolver.

    When property_zoning contains a verified district, that
    district controls property-specific requirements. The engine
    will not apply requirements from an unrelated district merely
    because that district exists in the municipality's code.

    When no verified property-specific district is supplied,
    zoning_district remains VERIFY.
    """

    requested_municipality = (
        municipality or ""
    ).strip()

    config = _get_source_config(
        requested_municipality
    )

    project = normalize_project_goal(
        project_goal
    )

    # --------------------------------------------------------
    # Property-specific zoning result
    # --------------------------------------------------------
    #
    # This is supplied by the parcel -> zoning resolver.
    # A verified property district must control which
    # district-specific requirements are reported.
    # --------------------------------------------------------

    property_zoning = (
        property_zoning
        if isinstance(property_zoning, dict)
        else None
    )

    property_zoning_district = "VERIFY"

    if property_zoning:
        property_zoning_district = (
            str(
                property_zoning.get(
                    "zoning_district",
                    "VERIFY",
                )
            ).strip()
            or "VERIFY"
        )

    has_verified_property_zoning = (
        property_zoning_district.upper()
        not in {
            "",
            "VERIFY",
            "UNKNOWN",
            "NOT RESOLVED",
        }
    )

    retrieved_at = _utc_now()

    # --------------------------------------------------------
    # Unknown municipality
    # --------------------------------------------------------

    if config is None:

        return {
            "municipality": requested_municipality,
            "zoning_district": "VERIFY",

            "source": {
                "municipality": requested_municipality,
                "source_type": "NOT_REGISTERED",
                "url": None,
                "description": (
                    "No authoritative municipal zoning source "
                    "has yet been registered in MIDRA."
                ),
                "authoritative": False,
            },

            "bulk_requirements": [],

            "project_requirements": [],

            "permitted_uses": [],

            "conditional_uses": [],

            "verification_items": [
                (
                    "Municipality is not yet registered in the "
                    "MIDRA zoning source registry."
                ),
                (
                    "Do not rely on estimated zoning requirements."
                ),
            ],

            "source_retrieved_at": retrieved_at,

            "confidence": "SOURCE_NOT_REGISTERED",

            "notes": [],
        }


    # --------------------------------------------------------
    # Try eCode360 first
    # --------------------------------------------------------

    ecode_config = config.get(
        "ecode",
        {},
    )

    ecode_text, ecode_meta = _retrieve_ecode_source(
        config
    )

    ecode_status = _retrieval_status(
        ecode_meta
    )


    # --------------------------------------------------------
    # Successful eCode retrieval
    # --------------------------------------------------------

    if ecode_text:

        source_url = ecode_meta.get(
            "url",
            ecode_config.get("url"),
        )

        source = _source_metadata(
            municipality=config["canonical_name"],
            source_type="eCode360",
            url=source_url,
            description=ecode_config.get(
                "description",
                "Municipal zoning code.",
            ),
            authoritative=True,
        )

        general_requirements = (
            _build_marlboro_general_requirements(
                source_text=ecode_text,
                source_url=source_url,
            )
        )

        bulk_requirements = list(
            general_requirements
        )

        zoning_district = (
            property_zoning_district
            if has_verified_property_zoning
            else "VERIFY"
        )

        # ----------------------------------------------------
        # District-specific requirements
        # ----------------------------------------------------
        #
        # Only report R-20 requirements when the resolved
        # property is actually R-20.
        # ----------------------------------------------------

        if (
            config["canonical_name"]
            == "Marlboro Township"
            and zoning_district.upper() == "R-20"
        ):
            bulk_requirements.extend(
                _build_marlboro_r20_requirements(
                    source_text=ecode_text,
                    source_url=source_url,
                )
            )

        project_requirements: list[dict[str, Any]] = []

        if (
            config["canonical_name"]
            == "Marlboro Township"
            and project == "pool"
            and zoning_district.upper()
            in {"R-20", "VERIFY"}
        ):
            # Residential pool rules are only appropriate when
            # the property is verified as residential or when
            # the district remains unresolved and the result is
            # explicitly presented as requiring verification.
            #
            # They must NOT be applied to a verified CF parcel.
            project_requirements = (
                _build_marlboro_pool_requirements(
                    source_text=ecode_text,
                    source_url=source_url,
                )
            )

        return {
            "municipality": config["canonical_name"],

            "zoning_district": zoning_district,

            "source": source,

            "bulk_requirements": bulk_requirements,

            "project_requirements": project_requirements,

            "permitted_uses": [],

            "conditional_uses": [],

            "property_zoning": property_zoning,

            "verification_items": (
                [
                    (
                        "Property-specific zoning district was "
                        "resolved from authoritative parcel evidence."
                    ),
                    (
                        "District-specific requirements are limited "
                        "to the resolved zoning district."
                    ),
                ]
                if has_verified_property_zoning
                else [
                    (
                        "Parcel-specific zoning district has not yet "
                        "been resolved from authoritative property "
                        "evidence."
                    ),
                    (
                        "District-specific requirements must be "
                        "matched to the actual zoning district before "
                        "being treated as property-specific."
                    ),
                ]
            ),

            "source_retrieved_at": retrieved_at,

            "confidence": (
                "PROPERTY_ZONING_AND_SOURCE_RETRIEVED"
                if has_verified_property_zoning
                else "SOURCE_RETRIEVED"
            ),

            "notes": [
                (
                    "eCode360 was successfully retrieved."
                ),
                (
                    f"eCode retrieval status: {ecode_status}."
                ),
                (
                    "Property-specific zoning evidence was supplied "
                    "to the zoning engine."
                    if has_verified_property_zoning
                    else
                    "No verified property-specific zoning evidence "
                    "was supplied to the zoning engine."
                ),
            ],
        }


    # --------------------------------------------------------
    # eCode failed â€” official municipal fallback
    # --------------------------------------------------------

    official_text, official_meta = (
        _retrieve_official_source(
            config
        )
    )

    official_status = _retrieval_status(
        official_meta
    )


    if official_text:

        official_config = config.get(
            "official",
            {},
        )

        source_url = official_meta.get(
            "url",
            official_config.get(
                "zoning_page"
            ),
        )

        source = _source_metadata(
            municipality=config["canonical_name"],
            source_type="Official Municipality",
            url=source_url,
            description=(
                "Official municipal zoning/code source."
            ),
            authoritative=True,
        )

        bulk_requirements = (
            _build_marlboro_general_requirements(
                source_text=official_text,
                source_url=source_url,
            )
        )

        zoning_district = (
            property_zoning_district
            if has_verified_property_zoning
            else "VERIFY"
        )

        # Do not attach R-20 requirements to a non-R-20 parcel.
        # The official fallback page does not reproduce the full
        # ordinance, so district-specific requirements remain
        # limited unless the source explicitly supports them.
        project_requirements: list[
            dict[str, Any]
        ] = []

        if (
            config["canonical_name"]
            == "Howell Township"
            and project == "pool"
        ):
            project_requirements = (
                _build_howell_pool_requirements()
            )

        if (
            config["canonical_name"]
            == "Marlboro Township"
            and project == "pool"
            and zoning_district.upper() == "R-20"
        ):
            # The official municipal page may establish the
            # zoning administration source but may not reproduce
            # the complete ordinance text. Do not fabricate
            # pool requirements from the page.
            project_requirements = []

        return {
            "municipality": config["canonical_name"],

            "zoning_district": zoning_district,

            "source": source,

            "property_zoning": property_zoning,

            "bulk_requirements": bulk_requirements,

            "project_requirements": project_requirements,

            "permitted_uses": [],

            "conditional_uses": [],

            "verification_items": (
                [
                    (
                        "eCode360 could not be retrieved automatically."
                    ),
                    (
                        "Official municipal zoning information was "
                        "successfully retrieved."
                    ),
                    (
                        "Property-specific zoning was resolved from "
                        "authoritative parcel evidence."
                    ),
                    (
                        "District-specific numerical requirements "
                        "must still be verified against the applicable "
                        "current schedule."
                    ),
                ]
                if has_verified_property_zoning
                else [
                    (
                        "eCode360 could not be retrieved automatically."
                    ),
                    (
                        "Official municipal zoning information was "
                        "successfully retrieved."
                    ),
                    (
                        "The actual parcel zoning district still "
                        "requires authoritative property-location "
                        "resolution."
                    ),
                    (
                        "Numerical requirements should only be reported "
                        "when explicitly extracted from the authoritative "
                        "municipal code or schedule."
                    ),
                ]
            ),

            "source_retrieved_at": retrieved_at,

            "confidence": (
                "PROPERTY_ZONING_AND_OFFICIAL_SOURCE_RETRIEVED"
                if has_verified_property_zoning
                else "OFFICIAL_SOURCE_RETRIEVED"
            ),

            "notes": [
                (
                    f"eCode retrieval status: {ecode_status}."
                ),
                (
                    f"Official municipal retrieval status: "
                    f"{official_status}."
                ),
                (
                    "Property-specific zoning evidence was supplied "
                    "to the zoning engine."
                    if has_verified_property_zoning
                    else
                    "No verified property-specific zoning evidence "
                    "was supplied to the zoning engine."
                ),
            ],
        }


    # --------------------------------------------------------
    # Both sources failed
    # --------------------------------------------------------

    notes: list[str] = []

    if ecode_meta.get("error"):
        notes.append(
            "eCode360: "
            + str(ecode_meta["error"])
        )

    if official_meta.get("error"):
        notes.append(
            "Official municipal source: "
            + str(official_meta["error"])
        )

    return {
        "municipality": config["canonical_name"],

        "zoning_district": (
            property_zoning_district
            if has_verified_property_zoning
            else "VERIFY"
        ),

        "property_zoning": property_zoning,

        "source": _source_metadata(
            municipality=config["canonical_name"],
            source_type="eCode360 + Official Municipality",
            url=ecode_config.get("url"),
            description=(
                "Authoritative municipal zoning sources."
            ),
            authoritative=True,
        ),

        "bulk_requirements": [],

        "project_requirements": [],

        "permitted_uses": [],

        "conditional_uses": [],

        "verification_items": [
            (
                "The authoritative eCode360 source could not "
                "be retrieved automatically."
            ),
            (
                "The official municipal fallback could not "
                "be retrieved automatically."
            ),
            (
                "MIDRA will not guess zoning or bulk requirements."
            ),
            (
                "Verify the municipality's current zoning ordinance "
                "before relying on requirements."
            ),
        ],

        "source_retrieved_at": retrieved_at,

        "confidence": "SOURCE_RETRIEVAL_FAILED",

        "notes": notes,
    }



