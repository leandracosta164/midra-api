# ============================================================
# HTTP HELPERS
# ============================================================

def _utc_now() -> str:
    """Return an ISO-8601 UTC timestamp."""
    return datetime.now(timezone.utc).isoformat()


def _headers() -> dict[str, str]:
    """
    Headers used for municipal-code retrieval.

    eCode360 can reject simplistic automated requests. These
    headers provide a normal browser-like Accept profile while
    retaining an explicit MIDRA user agent.
    """
    return {
        "User-Agent": USER_AGENT,
        "Accept": (
            "text/html,application/xhtml+xml,"
            "application/xml;q=0.9,text/plain;q=0.8,*/*;q=0.7"
        ),
        "Accept-Language": "en-US,en;q=0.9",
        "Cache-Control": "no-cache",
        "Pragma": "no-cache",
    }


def _download(
    url: str,
    *,
    referer: str | None = None,
) -> tuple[str | None, dict[str, Any]]:
    """
    Download an HTML/text source.

    Returns
    -------
    (text, metadata)

    If retrieval fails, text is None and metadata contains
    the HTTP/error information.
    """

    headers = _headers()

    if referer:
        headers["Referer"] = referer

    try:
        with httpx.Client(
            timeout=REQUEST_TIMEOUT,
            follow_redirects=True,
            headers=headers,
        ) as client:

            response = client.get(url)

            metadata = {
                "url": str(response.url),
                "status_code": response.status_code,
                "content_type": response.headers.get(
                    "content-type",
                    "",
                ),
            }

            if response.status_code >= 400:
                metadata["error"] = (
                    f"HTTP {response.status_code}"
                )
                return None, metadata

            content = response.content

            if len(content) > MAX_SOURCE_BYTES:
                metadata["error"] = (
                    "Source exceeded maximum permitted size."
                )
                return None, metadata

            return response.text, metadata

    except httpx.HTTPError as exc:
        return None, {
            "url": url,
            "error": str(exc),
        }

    except Exception as exc:
        return None, {
            "url": url,
            "error": str(exc),
        }


# ============================================================
# TEXT CLEANING
# ============================================================

def _strip_html(html: str) -> str:
    """
    Convert basic HTML into searchable plain text.

    This deliberately avoids requiring BeautifulSoup so the
    existing MIDRA environment remains lightweight.
    """

    text = re.sub(
        r"(?is)<script.*?>.*?</script>",
        " ",
        html,
    )

    text = re.sub(
        r"(?is)<style.*?>.*?</style>",
        " ",
        text,
    )

    text = re.sub(
        r"(?is)<[^>]+>",
        " ",
        text,
    )

    replacements = {
        "&nbsp;": " ",
        "&amp;": "&",
        "&quot;": '"',
        "&#39;": "'",
        "&lt;": "<",
        "&gt;": ">",
    }

    for old, new in replacements.items():
        text = text.replace(old, new)

    text = re.sub(r"\s+", " ", text)

    return text.strip()


def _normalize_text(text: str) -> str:
    """Normalize whitespace for searching."""
    text = text.replace("\xa0", " ")
    text = re.sub(r"\s+", " ", text)
    return text.strip()


# ============================================================
# PROJECT NORMALIZATION
# ============================================================

def normalize_project_goal(project_goal: str) -> str:
    """Normalize a user project description."""
    value = (project_goal or "other").strip().lower()

    if value in PROJECT_ALIASES:
        return PROJECT_ALIASES[value]

    for phrase, normalized in PROJECT_ALIASES.items():
        if phrase in value:
            return normalized

    return "other"


