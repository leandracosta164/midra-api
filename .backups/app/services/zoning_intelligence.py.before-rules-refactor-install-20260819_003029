# ============================================================
# FALLBACK SOURCE
# ============================================================

def _retrieve_official_source(
    config: dict[str, Any],
) -> tuple[str | None, dict[str, Any]]:
    """
    Retrieve the municipality's official zoning page.

    This is the fallback when eCode360 cannot be reached.
    """

    official = config.get("official", {})

    if not official.get("enabled"):
        return None, {
            "error": "Official municipal fallback is disabled."
        }

    url = official.get("zoning_page")

    if not url:
        return None, {
            "error": "No official zoning page configured."
        }

    return _download(url)


# ============================================================
# ECODE RETRIEVAL
# ============================================================

def _retrieve_ecode_source(
    config: dict[str, Any],
) -> tuple[str | None, dict[str, Any]]:
    """
    Retrieve eCode360.

    The important behavior here is that failure does NOT become
    a false zoning result. The caller will move to the official
    municipal fallback.
    """

    ecode = config.get("ecode", {})

    if not ecode.get("enabled"):
        return None, {
            "error": "eCode360 source is disabled."
        }

    url = ecode.get("url")

    if not url:
        return None, {
            "error": "No eCode360 URL configured."
        }

    return _download(url)


# ============================================================
# SOURCE STATUS
# ============================================================

def _retrieval_status(
    metadata: dict[str, Any],
) -> str:

    status_code = metadata.get("status_code")

    if status_code == 200:
        return "RETRIEVED"

    if status_code == 403:
        return "BLOCKED_403"

    if status_code == 404:
        return "NOT_FOUND"

    if status_code:
        return f"HTTP_{status_code}"

    return "RETRIEVAL_FAILED"


