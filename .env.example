# Optional authenticated eCode360 API access.
# Obtain these credentials directly from the municipality/eCode360.
# Leave blank to preserve ordinary HTTP retrieval behavior.
ECODE360_API_KEY=
ECODE360_API_SECRET=


# Public MIDRA API deployment boundary
# Production example:
# MIDRA_API_PUBLIC_ORIGIN=https://api.midraengineering.com
# MIDRA_API_ALLOWED_HOSTS=api.midraengineering.com
MIDRA_API_PUBLIC_ORIGIN=http://localhost:8000
MIDRA_API_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Internal MIDRA Engineering workplace
MIDRA_ENGINEERING_ADMIN_EMAIL=
MIDRA_ENGINEERING_ADMIN_PASSWORD=
MIDRA_ENGINEERING_SESSION_HOURS=12
MIDRA_ENGINEERING_WEB_ORIGIN=http://localhost:4321
MIDRA_WORKPLACE_WEB_ORIGIN=http://localhost:4323

# MIDRA Property web origins allowed to call this API.
# Comma-separated, no trailing slash required.
# Production example:
# MIDRA_PROPERTY_WEB_ORIGINS=https://property.midraengineering.com
MIDRA_PROPERTY_WEB_ORIGINS=http://localhost:4322,http://127.0.0.1:4322,http://localhost:3000,http://127.0.0.1:3000

# MIDRA Property workspace authentication.
# Use a long random secret in deployed environments.
MIDRA_PROPERTY_ADMIN_EMAIL=
MIDRA_PROPERTY_ADMIN_PASSWORD=
MIDRA_PROPERTY_AUTH_SECRET=
MIDRA_PROPERTY_SESSION_HOURS=12


# Controlled Engineering proposal delivery (disabled until configured)
MIDRA_PROPOSAL_EMAIL_HOST=
MIDRA_PROPOSAL_EMAIL_PORT=587
MIDRA_PROPOSAL_EMAIL_USERNAME=
MIDRA_PROPOSAL_EMAIL_PASSWORD=
MIDRA_PROPOSAL_EMAIL_FROM=
MIDRA_PROPOSAL_EMAIL_USE_TLS=true
MIDRA_PROPOSAL_EMAIL_USE_SSL=false

# Client proposal response portal
MIDRA_PROPOSAL_RESPONSE_SECRET=replace-with-a-long-random-secret
MIDRA_PROPOSAL_RESPONSE_TTL_DAYS=30
MIDRA_PROPERTY_PUBLIC_ORIGIN=http://localhost:4322

# Production readiness notes
# In deployed production set APP_ENV=production and DEBUG=false.
# Use HTTPS origins for MIDRA_API_PUBLIC_ORIGIN, MIDRA_ENGINEERING_WEB_ORIGIN, MIDRA_WORKPLACE_WEB_ORIGIN,
# MIDRA_PROPERTY_WEB_ORIGINS, and MIDRA_PROPERTY_PUBLIC_ORIGIN. Keep all passwords/signing secrets outside source control.

# In production, MIDRA_API_ALLOWED_HOSTS must contain only the deployed API hostname(s); do not use *.

# Production observability and HTTP request safeguards
MIDRA_LOG_LEVEL=INFO
MIDRA_REQUEST_ID_HEADER=X-Request-ID
# Must be larger than MIDRA_ENGINEERING_MAX_FILE_MB because document uploads are base64 JSON.
MIDRA_ENGINEERING_MAX_REQUEST_MB=40
